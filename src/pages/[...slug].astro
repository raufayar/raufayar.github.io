---
// --- ASTRO MERKEZİ VERİTABANI MOTORU (Ameleliği Sıfırlayan Katman) ---
export async function getStaticPaths() {
  const publications = [
    {
      slug: "geo-seo",
      heading: "Generative Engine Optimization (GEO)",
      description: "Advanced frameworks engineered for AI search visibility, LLM indexing, and semantic optimization matrices.",
      cards: [
        { title: "LLM Ingestion & Indexing", body: "Deploy micro-semantic context fragments directly into your HTML source. This forces generative crawlers to map your domain as a primary factual entity." },
        { title: "AI Overview Citation Hub", body: "Optimize document vector similarity to exceed 0.94+ against competitive target queries, positioning your brand inside SGE boxes." }
      ]
    },
    {
      slug: "data-science",
      heading: "Data Science & Predictive Systems",
      description: "Intelligent decision engines, data engineering pipelines, and real-time mathematical modeling platforms.",
      cards: [
        { title: "Predictive Trend Analytics", body: "Audit mathematical search momentum arrays before consumer drop-off curves collapse. Leverage client-side extrapolation networks." },
        { title: "Synthetic Traffic Filtration", body: "Isolate microsecond click-farm signatures and bot network clusters using behavior telemetry scripts." }
      ]
    },
    {
      slug: "digital-growth",
      heading: "Digital Growth & Bio-Hacks",
      description: "Sustainable digital visibility strategies, conversion optimization, and organic audience expansion models.",
      cards: [
        { title: "The Monochrome Deprivation Mode", body: "Turn your smartphone screen to absolute Grayscale (Monochrome). This completely blinds corporate visual dopamine algorithms instantly, crushing screen addiction." },
        { title: "The 7-Second Intercept Buffer", body: "Deploy a 7-second blank delay script before social apps trigger. This structurally intercepts sub-conscious reflex clicks, reclaiming biological cognitive focus." }
      ]
    }
  ];

  return publications.map(pub => ({
    params: { slug: pub.slug },
    props: { pub }
  }));
}

const { pub } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pub.heading} | Rauf Ayar</title>
    <style>
        /* Sizin o çok sevdiğiniz yeşil-siyah kurumsal tasarım kodları */
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: #0a0a0a; color: #e0e0e0; padding: 40px 20px; margin: 0; min-height: 100vh; }
        .container { max-width: 900px; margin: 0 auto; }
        .back-link { display: inline-block; margin-bottom: 2rem; color: #00ff9d; text-decoration: none; font-weight: bold; }
        .back-link:hover { text-decoration: underline; }
        h1 { color: #00ff9d; margin-bottom: 10px; margin-top: 0; font-size: 2.2rem; }
        .desc { color: #aaaaaa; font-size: 1.1rem; max-width: 800px; line-height: 1.6; margin-bottom: 30px; }
        .grid { display: grid; gap: 24px; }
        .card { background: #1a1a1a; border-radius: 12px; padding: 24px; border: 1px solid #333; text-align: left; }
        .card h3 { color: #00ff9d; margin: 0 0 12px 0; }
        .card p { margin: 0; line-height: 1.6; }
        #giscus-zone { margin-top: 40px; border-top: 1px solid #333; padding-top: 20px; }
    </style>
</head>
<body>

    <div class="container">
        <a href="https://raufayar.net" class="back-link">← Back to Home</a>

        <h1>{pub.heading}</h1>
        <p class="desc">{pub.description}</p>
        
        <div class="grid">
            {pub.cards.map((card) => (
                <div class="card">
                    <h3>{card.title}</h3>
                    <p>{card.body}</p>
                </div>
            ))}
        </div>
        
        <!-- Her sayfaya otomatik açılan sıfır reklam Giscus forum alanı -->
        <div id="giscus-zone"></div>
    </div>

    <script is:inline>
        // Astro içinde çalışan akıllı forum enjektörü
        const giscusZone = document.getElementById("giscus-zone");
        if (giscusZone) {
            giscusZone.innerHTML = `<div class="giscus"></div>`;
            const script = document.createElement("script");
            script.src = "https://giscus.app";
            script.setAttribute("data-repo", "raufayar/raufayar.github.io");
            script.setAttribute("data-repo-id", "R_kgDOS43ysQ");
            script.setAttribute("data-category", "General");
            script.setAttribute("data-category-id", "DIC_kwDOS43ysc4C_ECO");
            script.setAttribute("data-mapping", "pathname");
            script.setAttribute("data-strict", "0");
            script.setAttribute("data-reactions-enabled", "1");
            script.setAttribute("data-input-position", "bottom");
            script.setAttribute("data-theme", "dark_dimmed");
            script.setAttribute("data-lang", "en");
            script.setAttribute("crossorigin", "anonymous");
            script.async = true;
            giscusZone.appendChild(script);
        }
    </script>
</body>
</html>
